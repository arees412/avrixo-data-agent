# Avrixo DataAgent optional environment variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Development
NODE_ENV=development

# Governed query limits
QUERY_MAX_ROWS=500
QUERY_TIMEOUT_MS=5000

# Optional PostgreSQL data source. Supply through a secret manager in production.
# POSTGRES_URL=postgresql://readonly_user:replace_me@localhost:5432/analytics

# Optional AI-assisted inherited chat route. Deterministic CI does not use it.
# AI_GATEWAY_API_KEY=replace_me
